[Unit]
Description=Embed new papers with Voyage 4 and refresh the recent-paper index
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=arxiv
Group=arxiv
WorkingDirectory=/home/arxiv/arxiv_troller/django
Environment=DJANGO_SETTINGS_MODULE=arxiv_troller.settings_django_deploy
ExecStart=/home/arxiv/arxiv_troller/venv/bin/python manage.py add_voyage4_embeddings
Nice=10
TimeoutStartSec=4h
