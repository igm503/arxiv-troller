[Unit]
Description=Preserve old embeddings and generate full-precision Voyage 4 archive via standard API
After=network-online.target postgresql.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=arxiv
Group=arxiv
WorkingDirectory=/home/arxiv/arxiv_troller
Environment=OPENBLAS_NUM_THREADS=1
Environment=TOKENIZERS_PARALLELISM=true
Environment=RAYON_NUM_THREADS=3
Environment=HF_HOME=/tmp/arxiv-voyage4-tokenizer-cache
ExecStart=/bin/bash /home/arxiv/arxiv_troller/operations/voyage4/backfill.sh
Restart=on-failure
RestartSec=120
Nice=5
TimeoutStopSec=180
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
